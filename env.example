# ════════════════════════════════════════════════════════════════
# 🔐 VARIÁVEIS DE AMBIENTE - SOPHIA BOT v7.2
# ════════════════════════════════════════════════════════════════
# 
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA faça commit do arquivo .env no Git!
#
# ════════════════════════════════════════════════════════════════

# 🤖 TELEGRAM BOT
TELEGRAM_TOKEN=seu_token_do_botfather_aqui
# Como obter: @BotFather no Telegram → /newbot

# 🧠 GROK AI
GROK_API_KEY=sua_key_do_grok_aqui
# Como obter: https://console.x.ai/

# 🗄️ REDIS (Railway gera automaticamente se usar Redis do Railway)
REDIS_URL=redis://default:senha@host:porta
# Railway: Gerado automaticamente quando adiciona Redis
# Upstash: Pegar em https://upstash.com

# 🌐 WEBHOOK (Railway gera automaticamente)
WEBHOOK_BASE_URL=https://seu-app.up.railway.app
# Railway: Aparece como RAILWAY_STATIC_URL

# 📢 CANAIS
CANAL_PREVIAS_LINK=https://t.me/previasdamayaofc
CANAL_VIP_LINK=https://t.me/+seu_link_vip_aqui
PRECO_VIP=R$ 9,90

# 👑 ADMIN
ADMIN_IDS=1293602874
# Seu Telegram ID. Múltiplos: 123,456,789


# 💌 FOTO PERSONALIZADA COM NOME
# URL base do seu projeto Gerador-Placa-com-Nome-IA no Railway.
# Ex.: https://gerador-placa-production.up.railway.app
PERSONALIZED_PHOTO_API_URL=https://SEU-GERADOR.up.railway.app
# Se você configurar API_KEY no projeto gerador, coloque a MESMA chave aqui.
PERSONALIZED_PHOTO_API_KEY=
PERSONALIZED_PHOTO_TIMEOUT_SECONDS=20
PERSONALIZED_PHOTO_SENT_TTL_DAYS=365

# 🔢 PORTA (Railway gera automaticamente)
PORT=8080
# Não precisa configurar manualmente no Railway

# ════════════════════════════════════════════════════════════════
# 💡 DICAS:
# ════════════════════════════════════════════════════════════════
#
# 1. No Railway, adicione estas variáveis em "Variables"
# 2. REDIS_URL, PORT, WEBHOOK_BASE_URL são gerados automaticamente
# 3. Você só precisa adicionar: TELEGRAM_TOKEN, GROK_API_KEY
# 4. Links dos canais e ADMIN_IDS são opcionais (hardcoded no código)
#
# ════════════════════════════════════════════════════════════════
